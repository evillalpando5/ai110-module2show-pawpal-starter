
classDiagram
    class Owner {
        +int ownerId
        +String name
        +String email
        +List pets
        +addPet()
        +editOwnerInfo()
        +getPet()
        +getAllTasks()
    }

    class Pet {
        +int petId
        +int ownerId
        +String name
        +String species
        +String age
        +String careNotes
        +List tasks
        +editPetInfo()
        +addTask()
        +removeTask()
        +getTask()
        +dueTasks()
    }

    class Task {
        +int taskId
        +int petId
        +String title
        +int duration
        +int priority
        +String earliestStart
        +String latestEnd
        +String recurrence
        +boolean completed
        +editTask()
        +markCompleted()
        +fitsInWindow()
        +isDueToday()
    }

    class Scheduler {
        +Owner owner
        +Date scheduleDate
        +float availableHours
        +List entries
        +generateSchedule()
        +checkConstraints()
        +prioritizeTasks()
        +displayPlan()
        +explainPlan()
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : needs
    Scheduler "1" --> "1" Owner : reads from
